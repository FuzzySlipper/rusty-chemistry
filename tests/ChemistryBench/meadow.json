// CraftSurvive's chemistry (#10293): what the rusty-chemistry kernel simulates around the player. Rules name
// properties, never pairs of things (rusty-chemistry docs/chemistry.md). Fire spreads because heat transfers
// and grass ignites when hot and dry; green grass must dry out first and catches unevenly, so a fire creeps
// through it, while dry grass goes up at once and the fire races; rain wets what lies open to the sky, snow
// lying on the ground keeps it wet (the "snow" modulator is the cover where the player stands), and
// everything slowly dries, but living grass draws its water back up (it rests at its own moisture); water and snow wet what touches them;
// smoke rises and vents to the open sky.
{
  "quantities": [
    { "id": "heat", "ambient": 20, "min": -50, "max": 1500, "settle": 0.05, "epsilon": 0.01, "transfer": { "rate": 3, "drift": true } },
    { "id": "moisture", "max": 1, "settle": 0.01, "epsilon": 0.0001, "transfer": { "rate": 0.2 } },
    { "id": "smoke", "max": 10, "epsilon": 0.001, "transfer": { "rate": 1, "drift": true, "rise": 0.5 } },
    { "id": "fuel" }
  ],
  "materials": [
    { "id": "air", "sky": true, "conduct": { "heat": 0.08, "smoke": 1, "moisture": 0.1 } },
    { "id": "stone", "conduct": { "heat": 0.02 } },
    { "id": "soil", "conduct": { "heat": 0.02, "moisture": 0.3 } },
    { "id": "wood", "conduct": { "heat": 0.04 } },
    { "id": "snow", "conduct": { "heat": 0.02, "moisture": 0.5 }, "initial": { "moisture": 1 } },
    { "id": "water", "sky": true, "conduct": { "heat": 0.3, "moisture": 1 }, "initial": { "moisture": 1 } },
    { "id": "grass", "sky": true, "conduct": { "heat": 0.06, "smoke": 0.5, "moisture": 0.5 }, "initial": { "fuel": 6, "moisture": 0.4 },
      "rest": { "moisture": { "to": 0.4, "settle": 0.3 } } },
    { "id": "dry-grass", "sky": true, "conduct": { "heat": 0.12, "smoke": 0.5, "moisture": 0.5 }, "initial": { "fuel": 4, "moisture": 0.05 } },
    { "id": "burning-grass", "sky": true, "conduct": { "heat": 0.12, "smoke": 0.5, "moisture": 0.5 } },
    { "id": "burnt-ground", "sky": true, "conduct": { "heat": 0.05, "smoke": 0.5, "moisture": 0.5 } }
  ],
  "reactions": [
    { "id": "combustion", "in": ["burning-grass"], "rate": 1, "consumes": { "fuel": 1 }, "produces": { "heat": 1200, "smoke": 2 } },
    { "id": "smoke-vents", "when": [{ "open": true }], "rate": 0.3, "per": "smoke", "consumes": { "smoke": 1 } },
    { "id": "water-wets", "in": ["water", "snow"], "rate": 5, "produces": { "moisture": 1 } },
    { "id": "quench", "in": ["water"], "when": [{ "quantity": "heat", "atLeast": 30 }], "rate": 2, "per": "heat", "consumes": { "heat": 1 } },
    { "id": "drying", "when": [{ "quantity": "heat", "atLeast": 100 }], "rate": 0.1, "consumes": { "moisture": 1 } },
    { "id": "rain-wets", "in": ["grass", "dry-grass", "burning-grass", "burnt-ground", "soil"], "when": [{ "open": true }],
      "rate": 0.2, "modulator": "rain", "produces": { "moisture": 1 } },
    { "id": "snow-wets", "in": ["grass", "dry-grass", "burning-grass", "burnt-ground", "soil"], "when": [{ "open": true }],
      "rate": 2, "modulator": "snow", "produces": { "moisture": 1 } }
  ],
  "transforms": [
    { "id": "ignite-dry", "from": ["dry-grass"], "to": "burning-grass", "chance": 3,
      "when": [{ "quantity": "heat", "atLeast": 250 }, { "quantity": "moisture", "atMost": 0.2 }] },
    { "id": "ignite-green", "from": ["grass"], "to": "burning-grass", "chance": 0.3,
      "when": [{ "quantity": "heat", "atLeast": 250 }, { "quantity": "moisture", "atMost": 0.2 }] },
    { "id": "douse", "from": ["burning-grass"], "to": "grass", "when": [{ "quantity": "moisture", "atLeast": 0.5 }] },
    { "id": "burn-out", "from": ["burning-grass"], "to": "burnt-ground", "when": [{ "quantity": "fuel", "atMost": 0 }] }
  ]
}
