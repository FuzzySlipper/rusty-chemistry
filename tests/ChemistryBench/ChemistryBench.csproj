<Project Sdk="Microsoft.NET.Sdk">
  <!-- The kernel's step cost on a player-sized window of meadow, and a hash of its state for checking that an
       optimisation leaves the field's results unchanged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RustyChemistry/RustyChemistry.csproj" />
    <None Include="meadow.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
