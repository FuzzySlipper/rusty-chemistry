<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>ChemistrySandbox.SandboxProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-chemistry</RustyEngineProductId>
    <RustyEngineProductTitle>Chemistry Sandbox</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>chemistry-sandbox</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty.chemistry.sandbox</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineProductInputCursorMode>unlocked</RustyEngineProductInputCursorMode>
    <RustyEngineProductDefaultWorldLights>neutral</RustyEngineProductDefaultWorldLights>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$(MSBuildProjectDirectory)/../RustyChemistry;$(RustyEngineProductUiRoot);$(RustyEngineProductContentRoot)</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
    <ProjectReference Include="../RustyChemistry/RustyChemistry.csproj" />
    <RustyEngineProductInputIntent Include="sandbox.command" Value="payload:rusty.chemistry.command.v1" />
  </ItemGroup>
</Project>
