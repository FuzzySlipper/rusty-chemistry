<Project Sdk="Microsoft.NET.Sdk">
  <!-- The chemistry kernel is Engine-free on purpose: products link it and adapt it to
       their voxels, weather and bodies; its checks run without a host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>RustyChemistry</RootNamespace>
    <!-- Every cell runs through the step's loops, and unoptimized they are about eight times slower:
         `rusty dev` builds Debug, so the kernel is optimized in every configuration. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
